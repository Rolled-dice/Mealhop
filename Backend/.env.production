# MongoDB Connection
MONGODB_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/mealhop

# JWT Configuration
JWT_SECRET=change-this-to-a-strong-random-secret-in-production

# Server
PORT=8000
NODE_ENV=production

# Email Configuration (for password reset OTP)
EMAIL=your-email@gmail.com
EMAIL_PASS=your-app-password

# Stripe (optional - works in mock mode without)
STRIPE_SECRET_KEY=
