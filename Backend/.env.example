# MongoDB Connection
MONGODB_URL=mongodb://localhost:27017/mealhop

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Email Configuration (for password reset OTP)
EMAIL=your-email@gmail.com
EMAIL_PASS=your-app-password

# Stripe Payment Gateway (get from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# OpenAI for AI Chat Support (get from https://platform.openai.com/api-keys)
# Optional - leave blank to use rule-based FAQ bot
OPENAI_API_KEY=sk_your_openai_api_key